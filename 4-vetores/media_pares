#include <iostream>
#include <iomanip>
using namespace std;

int main(){
    int n;

    cout << "Quantos elementos vai ter o vetor? ";
    cin >> n;

    int vetor[n];

    for(int i = 0; i < n; i++){
        cin >> vetor[i];
    }

    int soma = 0;
    int qtd_pares = 0;

    for(int i = 0; i < n; i++){
        if(vetor[i] % 2 == 0){
            soma = soma + vetor[i];
            qtd_pares = qtd_pares + 1;
        }
    }

    if(qtd_pares == 0){
        cout << "NENHUM NUMERO PAR" << endl;
    }
    else{
        double media = (double)soma / qtd_pares;
        cout << "MEDIA DOS PARES = " 
             << fixed << setprecision(1) 
             << media << endl;
    }

    return 0;
}
